# Настройки рабочего сайта «Мой лучший агент».
# Скопируйте файл в .env рядом с package.json, заполните и запустите: npm start
# (.env читается автоматически; храните его только на сервере, не публикуйте).

# --- обязательно ---
NODE_ENV=production
PORT=3000
# Публичный https-адрес сайта (ссылки в письмах, push, документах, возврат после оплаты)
BASE_URL=https://mybestagent.ru
# Первый администратор: войдите на сайт с этим e-mail по коду — роль «Администратор» назначится автоматически
ADMIN_EMAIL=

# --- e-mail: коды входа и уведомления (любой SMTP: Яндекс 360, Mail.ru для бизнеса, Unisender Go и т. п.) ---
# Логин с «@» записывается как %40. Пример для Яндекс 360:
#   SMTP_URL=smtps://robot%40mybestagent.ru:ПАРОЛЬ_ПРИЛОЖЕНИЯ@smtp.yandex.ru:465
SMTP_URL=
MAIL_FROM=«Мой лучший агент» <robot@mybestagent.ru>

# --- SMS: коды входа по номеру телефона (SMS.ru → Настройки → API, ключ api_id) ---
SMSRU_API_ID=
# Имя отправителя, согласованное в SMS.ru (необязательно)
SMSRU_FROM=

# --- оплата: ЮKassa (карты РФ, СБП, чеки 54-ФЗ) ---
# Личный кабинет ЮKassa → Интеграция → Ключи API. HTTP-уведомления: https://<ваш сайт>/api/payments/webhook,
# события payment.succeeded и payment.canceled
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Ставка НДС в чеке: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20% (уточните у бухгалтера)
YOOKASSA_VAT_CODE=1
# Система налогообложения (1 — ОСН, 2 — УСН доход, 3 — УСН доход-расход, …), если в ЮKassa их несколько
YOOKASSA_TAX_SYSTEM=

# --- реквизиты оператора для правовых документов (можно также задать в админке → «Переводы») ---
# ИНН, КПП, ОГРН и банковские реквизиты фонда уже заданы в server/legal.js — переменные нужны, только чтобы их заменить
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_INN=
LEGAL_KPP=
LEGAL_OGRN=
LEGAL_ACCOUNT=
LEGAL_BANK=
LEGAL_BIK=
LEGAL_CORR=
LEGAL_EMAIL=support@mybestagent.ru

# --- web-push: если не задать, ключи создаются автоматически и хранятся в data/vapid.json ---
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:support@mybestagent.ru

# --- прочее ---
# Где хранить базу, фото и резервные копии (по умолчанию ./data)
DATA_DIR=
# Лимит места под фото на пользователя, МБ
UPLOAD_QUOTA_MB=200
